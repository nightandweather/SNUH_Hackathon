FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ARG SKLEARN_VERSION
COPY ml/requirements.txt /tmp/requirements.txt
RUN test -n "$SKLEARN_VERSION" \
    && pip install --no-cache-dir -r /tmp/requirements.txt "scikit-learn==$SKLEARN_VERSION" \
    && useradd --create-home --uid 10001 model
COPY ml /app/ml
USER model
EXPOSE 9000
CMD ["python", "-m", "ml.icu24.serve", "--model", "/models/model.joblib", "--host", "0.0.0.0", "--port", "9000"]
