# 시연 설정. 이 파일의 생성은 코드·패키지 반입 승인이 아닙니다.
# Python 서버와 pod_check.py에는 아래 값을 환경변수로 전달합니다.
PLANNER_MODE=offline
OFFLINE_DEMO=1
PORT=8002
HOST=127.0.0.1

# 실제로 승인된 단일 OpenAI 호환 endpoint/model 값만 입력합니다.
# 기본 API 키나 자동 모델 선택 값은 포함하지 않습니다.
# 쉘에서 읽을 때 실제 문자열은 작은따옴표로 감싸세요.
LLM_BASE_URL=''
LLM_MODEL=''
LLM_API_KEY=''

# 기존 설정의 KHDP_BASE_URL/KHDP_MODEL/KHDP_API_KEY도 호환합니다.
# LLM_*가 있으면 우선합니다. KHDP_MODELS만 있으면 첫 모델을 사용합니다.
# 실제 API 확인 전에는 PLANNER_MODE=offline을 유지하세요.
